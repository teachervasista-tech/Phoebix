# Phoebix Configuration File
#
# Create this file at: %LOCALAPPDATA%\Phoebix\.env
# Phoebix will load these settings on startup
#
# Lines starting with # are comments and ignored
# Empty values use defaults
# This file is optional - if not present, defaults are used

# ========================================================================
# Database Configuration
# ========================================================================

# Path to SQLite database file (default: %LOCALAPPDATA%\Phoebix\data\phoebix_desktop.sqlite3)
# Use absolute path (C:\...) or leave empty for default location
# PHOEBIX_DB_PATH=C:\Users\YourName\AppData\Local\Phoebix\data\phoebix_desktop.sqlite3

# ========================================================================
# User Accounts (First Run Only)
# ========================================================================

# Admin password set on first run (default: admin123)
# Must be 8+ characters for secure password
# Ignored if database already exists or password has been changed
# When set: skips the "choose new password" dialog on first login
# PHOEBIX_ADMIN_PASSWORD=MySecureAdminPass123

# ========================================================================
# PhonePe Payment Gateway (UPI & Card Payments)
# ========================================================================

# Environment: sandbox or production
# Use sandbox for testing, production for real transactions
PHONEPE_ENV=sandbox

# Client ID from PhonePe Business Dashboard
# Get this from: https://business.phonepe.com/
PHONEPE_CLIENT_ID=

# Client Secret from PhonePe Business Dashboard
# Keep this secret - never share or commit to version control
PHONEPE_CLIENT_SECRET=

# Client Version from PhonePe (usually "1" or latest version number)
PHONEPE_CLIENT_VERSION=

# Optional: URL for customer to return to after payment
# Default: Phoebix will show payment status inline
# PHOEBIX_RETURN_URL=https://www.phonepe.com/

# ========================================================================
# Advanced Configuration
# ========================================================================

# Database timeout in seconds (default: 15)
# Increase if experiencing "database is locked" errors
# PHOEBIX_DB_TIMEOUT=30

# ========================================================================
# Example Configurations
# ========================================================================

# Example 1: Fresh Start with Custom Admin Password
# PHOEBIX_ADMIN_PASSWORD=SecurePassword123
# PHONEPE_ENV=sandbox

# Example 2: Network Database
# PHOEBIX_DB_PATH=\\ServerName\Shared\phoebix_desktop.sqlite3

# Example 3: Full PhonePe Configuration
# PHONEPE_ENV=production
# PHONEPE_CLIENT_ID=your_client_id
# PHONEPE_CLIENT_SECRET=your_client_secret
# PHONEPE_CLIENT_VERSION=1

# ========================================================================
# Notes
# ========================================================================
#
# 1. This file is read ONCE at startup
#    - Changes require restart
#    - Invalid values are silently ignored and defaults used
#
# 2. First Run Initialization
#    - Database tables are created if they don't exist
#    - Default users (admin/cashier) are added if none exist
#    - Sample data is loaded only on brand new database
#    - Password from PHOEBIX_ADMIN_PASSWORD is used if set
#
# 3. Security Considerations
#    - Do not commit this file to version control
#    - Do not share PHONEPE_CLIENT_SECRET
#    - File permissions should restrict to current user only
#
# 4. Troubleshooting
#    - If database won't initialize, delete it and let Phoebix recreate it
#    - If settings don't take effect, restart Phoebix
#    - Check that file is in correct location: %LOCALAPPDATA%\Phoebix\.env
